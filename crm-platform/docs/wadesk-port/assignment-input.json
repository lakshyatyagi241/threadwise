  "clusters": {
    "platform": {
      "owner": "lakshya",
      "title": "Platform, identity, billing, admin and developer surface",
      "why": "Everything that defines who a user is, which workspace/plan they are on, what they pay, how admins run the platform and how outsiders integrate. Shares one data spine (users, workspaces, plans, wallet) and the kernel work (skeleton PR, web shell, operator layer), so one person owning it avoids the most cross-talk."
    },
    "messaging": {
      "owner": "vedant",
      "title": "WhatsApp core, inbox and automation",
      "why": "The WhatsApp connection engines, the Node bridge, chat, team inbox, broadcasts, campaigns, templates, auto-reply and the flow builder/runtime all read and write the same conversation, message and queue tables and share the channel core, so they must move together."
    },
    "crm": {
      "owner": "punya",
      "title": "CRM, commerce, AI and the other channels",
      "why": "Contacts and the sales objects around them (deals, companies, tasks, proposals, invoices, appointments), the commerce stack (catalog, storefront, checkout, shop integrations), AI agents and the nine non-WhatsApp channel adapters. The channels are siblings of one adapter pattern, so one person builds them consistently once the channel core exists."
    }
  },
