{
  "item": "Sheet3 #76 Alerting",
  "target": "100% P0 operational failure modes mapped to actionable alert + runbook",
  "statusValues": {
    "tested-live": "promtool must-fire and must-not-fire case AND a live induced failure in docs/performance/alerting/live-test-results.json",
    "tested-promtool": "promtool test case exists (synthetic series only)",
    "mapped-untested": "alert and runbook exist, no promtool case and no live test",
    "gap": "no alert possible today: the metric does not exist; gap.missingMetric names it"
  },
  "runbooks": {
    "p0": "docs/runbooks/p0-failure-modes.md",
    "queue": "docs/performance/queue-capacity/queue-observability-runbook.md",
    "eventLoop": "docs/performance/event-loop/event-loop-observability-runbook.md",
    "cache": "docs/runbooks/cache-hit-rate.md",
    "resources": "docs/performance/resource-limits/README.md",
    "outbox": "docs/runbooks/outbox-backlog.md",
    "failedWork": "docs/runbooks/failed-background-work.md",
    "backup": "docs/runbooks/backup-restore.md"
  },
  "modes": [
    {
      "id": "api-down",
      "failureMode": "API service down or not answering",
      "severity": "critical",
      "alerts": ["ApiProbeFailing", "RuntimeMetricsTargetDown"],
      "runbook": "docs/performance/event-loop/event-loop-observability-runbook.md",
      "status": "tested-live",
      "liveCase": ["api-stop", "probe-dead-port"]
    },
    {
      "id": "worker-down",
      "failureMode": "Worker process down (queues stop being processed)",
      "severity": "critical",
      "alerts": ["RuntimeMetricsTargetDown"],
      "runbook": "docs/performance/event-loop/event-loop-observability-runbook.md",
      "status": "tested-live",
      "liveCase": ["worker-kill"]
    },
    {
      "id": "queue-backlog",
      "failureMode": "Queue not draining / oldest job age (inbound, interactive, automation, bulk)",
      "severity": "critical",
      "alerts": ["CriticalQueueOldestJobAge", "BulkQueueBacklogNotDraining"],
      "runbook": "docs/performance/queue-capacity/queue-observability-runbook.md",
      "status": "tested-promtool"
    },
    {
      "id": "queue-failures",
      "failureMode": "Interactive/automation queue age, failed jobs and retry storm",
      "severity": "warning",
      "alerts": [
        "InteractiveQueueOldestJobAge",
        "AutomationQueueOldestJobAge",
        "QueueFailedJobsGrowing",
        "QueueRetryAmplification"
      ],
      "runbook": "docs/performance/queue-capacity/queue-observability-runbook.md",
      "status": "mapped-untested"
    },
    {
      "id": "outbox-stuck",
      "failureMode": "Outbox not draining (oldest due event age)",
      "severity": "critical",
      "alerts": ["OutboxNotDraining"],
      "runbook": "docs/runbooks/p0-failure-modes.md#outboxnotdraining",
      "status": "tested-live",
      "liveCase": ["outbox-stuck"]
    },
    {
      "id": "outbox-dead",
      "failureMode": "Outbox dead rows",
      "severity": "warning",
      "alerts": ["OutboxDeadRows"],
      "runbook": "docs/runbooks/p0-failure-modes.md#outboxdeadrows",
      "status": "tested-live",
      "liveCase": ["outbox-dead"]
    },
    {
      "id": "failed-work-open",
      "failureMode": "Failed webhook / provider send / job left unreplayed (durable failure store)",
      "severity": "warning",
      "alerts": ["DeadLetterOpenTooLong"],
      "runbook": "docs/runbooks/p0-failure-modes.md#deadletteropentoolong",
      "status": "tested-live",
      "liveCase": ["dead-letter-old"]
    },
    {
      "id": "failed-work-lost",
      "failureMode": "Failed work cannot be recorded (replay data lost)",
      "severity": "critical",
      "alerts": ["DeadLetterCaptureFailing"],
      "runbook": "docs/runbooks/p0-failure-modes.md#deadlettercapturefailing",
      "status": "tested-promtool",
      "note": "needs the capture to fail on purpose; not induced live"
    },
    {
      "id": "pg-down",
      "failureMode": "Postgres down or unreachable",
      "severity": "critical",
      "alerts": ["ApiProbeFailing", "ApiHighErrorRate"],
      "runbook": "docs/runbooks/p0-failure-modes.md#apihigherrorrate",
      "status": "tested-live",
      "liveCase": ["pg-down"],
      "note": "detected by symptom (the /ready probe and 5xx); no direct crm_db_up gauge exists"
    },
    {
      "id": "pg-pool",
      "failureMode": "Postgres connection pool exhausted",
      "severity": "critical",
      "alerts": ["DbPoolExhausted"],
      "runbook": "docs/runbooks/p0-failure-modes.md#dbpoolexhausted",
      "status": "tested-promtool",
      "note": "live: Pending reached, then the API process crashed (finding 8) so it never fired"
    },
    {
      "id": "pg-replica-lag",
      "failureMode": "Postgres replica lag",
      "severity": "warning",
      "alerts": [],
      "runbook": null,
      "status": "gap",
      "gap": {
        "missingMetric": "pg_replication_lag_seconds (postgres_exporter) or crm_db_replica_lag_seconds",
        "reason": "no exporter deployed and the app does not measure lag",
        "canInduceOnLaptop": false
      }
    },
    {
      "id": "pg-slow-queries",
      "failureMode": "Slow queries",
      "severity": "warning",
      "alerts": [],
      "runbook": null,
      "status": "gap",
      "gap": {
        "missingMetric": "crm_db_query_duration_seconds (no per-query timing) or pg_stat_statements_mean_exec_time_seconds (postgres_exporter)",
        "reason": "pg_stat_statements is enabled by a migration but nothing exports it",
        "canInduceOnLaptop": true
      }
    },
    {
      "id": "redis-down",
      "failureMode": "Redis down",
      "severity": "critical",
      "alerts": ["RedisDown", "CacheErrorRatioHigh"],
      "runbook": "docs/runbooks/p0-failure-modes.md#redisdown",
      "status": "tested-live",
      "liveCase": ["redis-stop"]
    },
    {
      "id": "redis-oom",
      "failureMode": "Redis full (maxmemory) / high memory",
      "severity": "critical",
      "alerts": ["RedisMemoryNearMax"],
      "runbook": "docs/runbooks/p0-failure-modes.md#redismemorynearmax",
      "status": "tested-live",
      "liveCase": ["redis-full"]
    },
    {
      "id": "disk-full",
      "failureMode": "Disk full on the host or database volume",
      "severity": "critical",
      "alerts": [],
      "runbook": "docs/runbooks/backup-restore.md",
      "status": "gap",
      "gap": {
        "missingMetric": "node_filesystem_avail_bytes (node_exporter, not deployed)",
        "reason": "no host exporter in observability.compose.yml",
        "canInduceOnLaptop": false
      }
    },
    {
      "id": "container-oom",
      "failureMode": "Container OOM-killed / memory near limit",
      "severity": "critical",
      "alerts": ["ContainerOomKilled", "ContainerMemoryCritical", "ContainerMemoryNearLimit"],
      "runbook": "docs/performance/resource-limits/README.md",
      "status": "tested-promtool",
      "note": "real cgroup limits not induced on the laptop"
    },
    {
      "id": "restart-loop",
      "failureMode": "Process restart loop",
      "severity": "critical",
      "alerts": ["ProcessRestartLoop"],
      "runbook": "docs/performance/resource-limits/README.md",
      "status": "tested-promtool"
    },
    {
      "id": "event-loop-stall",
      "failureMode": "Event-loop stall / blocking",
      "severity": "critical",
      "alerts": [
        "EventLoopLongStallCritical",
        "EventLoopBlockingWithImpact",
        "WorkerEventLoopBlockingWithQueueImpact",
        "WebEventLoopBlockingWithImpact",
        "HeapNearOom"
      ],
      "runbook": "docs/performance/event-loop/event-loop-observability-runbook.md",
      "status": "tested-promtool"
    },
    {
      "id": "http-5xx",
      "failureMode": "High 5xx error rate",
      "severity": "critical",
      "alerts": ["ApiHighErrorRate"],
      "runbook": "docs/runbooks/p0-failure-modes.md#apihigherrorrate",
      "status": "tested-live",
      "liveCase": ["pg-down"]
    },
    {
      "id": "high-latency",
      "failureMode": "High request latency",
      "severity": "critical",
      "alerts": ["ApiCallerLatencyHigh", "EventLoopBlockingWithImpact"],
      "runbook": "docs/performance/event-loop/event-loop-observability-runbook.md",
      "status": "tested-promtool"
    },
    {
      "id": "provider-send-failures",
      "failureMode": "WhatsApp / provider send failures",
      "severity": "critical",
      "alerts": ["QueueFailedJobsGrowing", "InteractiveQueueOldestJobAge", "DeadLetterOpenTooLong"],
      "runbook": "docs/runbooks/p0-failure-modes.md#deadletteropentoolong",
      "status": "mapped-untested",
      "note": "covered by the generic queue and failed-work alerts; a send-failure RATE per provider needs crm_provider_send_total{provider,outcome}, which does not exist"
    },
    {
      "id": "webhook-delivery",
      "failureMode": "Inbound/outbound webhook delivery failures",
      "severity": "critical",
      "alerts": ["CriticalQueueOldestJobAge", "DeadLetterOpenTooLong"],
      "runbook": "docs/performance/queue-capacity/queue-observability-runbook.md",
      "status": "tested-promtool",
      "note": "webhook-ingest and webhook-retry are in the Critical queue class"
    },
    {
      "id": "auth-failure-spike",
      "failureMode": "Login / auth failure spike",
      "severity": "warning",
      "alerts": [],
      "runbook": null,
      "status": "gap",
      "gap": {
        "missingMetric": "crm_auth_login_total{outcome}",
        "reason": "http metric has status class only (4xx mixes bad input and bad passwords) and no auth counter exists",
        "canInduceOnLaptop": true
      }
    },
    {
      "id": "cert-expiry",
      "failureMode": "TLS certificate about to expire",
      "severity": "critical",
      "alerts": [],
      "runbook": null,
      "status": "gap",
      "gap": {
        "missingMetric": "probe_ssl_earliest_cert_expiry (blackbox_exporter, not deployed; Traefik acme renewals are not scraped)",
        "reason": "no TLS probe",
        "canInduceOnLaptop": false
      }
    },
    {
      "id": "deploy-failure",
      "failureMode": "Deploy / release failure",
      "severity": "critical",
      "alerts": ["ApiProbeFailing", "RuntimeMetricsTargetDown"],
      "runbook": "deploy/hostinger/README.md",
      "status": "mapped-untested",
      "note": "a failed release that leaves the old slot serving is NOT detected: needs crm_build_info{version} plus a deploy-result metric"
    },
    {
      "id": "backup-failure",
      "failureMode": "Backup failure / stale backup",
      "severity": "critical",
      "alerts": ["BackupStale", "BackupMarkerMissing", "OffsiteBackupStale"],
      "runbook": "docs/runbooks/health-readiness.md#backupstale",
      "status": "tested-promtool"
    },
    {
      "id": "postgres-unreachable",
      "failureMode": "Postgres primary unreachable (direct gauge)",
      "severity": "critical",
      "alerts": ["PostgresDown"],
      "runbook": "docs/runbooks/health-readiness.md#postgresdown",
      "status": "tested-promtool"
    },
    {
      "id": "object-store-unreachable",
      "failureMode": "Object store unreachable (not part of /ready)",
      "severity": "warning",
      "alerts": ["ObjectStoreUnreachable"],
      "runbook": "docs/runbooks/health-readiness.md#objectstoreunreachable",
      "status": "tested-promtool"
    },
    {
      "id": "monitoring-dead",
      "failureMode": "Prometheus or Alertmanager dead (dead-man's-switch)",
      "severity": "critical",
      "alerts": ["Watchdog"],
      "runbook": "docs/runbooks/health-readiness.md#watchdog",
      "status": "tested-promtool"
    },
    {
      "id": "metrics-pipeline-targets",
      "failureMode": "Metrics pipeline: exporter stale or target down",
      "severity": "critical",
      "alerts": ["RuntimeMetricsTargetDown", "RuntimeMetricsStale"],
      "runbook": "docs/performance/event-loop/event-loop-observability-runbook.md",
      "status": "tested-live",
      "liveCase": ["worker-kill", "api-stop"]
    },
    {
      "id": "cache-health",
      "p0": false,
      "failureMode": "Cache hit ratio low / cache metrics missing (degradation, not an outage)",
      "severity": "warning",
      "alerts": ["CacheHitRatioLow", "CacheMetricsMissing"],
      "runbook": "docs/runbooks/cache-hit-rate.md",
      "status": "tested-promtool"
    },
    {
      "id": "event-loop-warnings",
      "p0": false,
      "failureMode": "Event-loop, heap and GC early warnings",
      "severity": "warning",
      "alerts": [
        "EventLoopDelayP95Warning",
        "EventLoopDelayP99Warning",
        "EventLoopUtilizationHigh",
        "ProcessHeapNearLimit",
        "GcPauseHigh",
        "EventLoopLongStallWarning"
      ],
      "runbook": "docs/performance/event-loop/event-loop-observability-runbook.md",
      "status": "tested-promtool"
    },
    {
      "id": "resource-warnings",
      "p0": false,
      "failureMode": "CPU throttling and PID limit early warnings",
      "severity": "warning",
      "alerts": ["ContainerCpuThrottled", "ContainerPidsNearLimit"],
      "runbook": "docs/performance/resource-limits/README.md",
      "status": "tested-promtool"
    },
    {
      "id": "metrics-pipeline-self",
      "failureMode": "Prometheus or Alertmanager itself down (alerts silently stop)",
      "severity": "critical",
      "alerts": [],
      "runbook": null,
      "status": "gap",
      "gap": {
        "missingMetric": "an always-firing Watchdog alert (vector(1)) plus an external dead-man's-switch receiver; up{job=\"prometheus\"} cannot be seen by a dead Prometheus",
        "reason": "needs a service outside this stack",
        "canInduceOnLaptop": true
      }
    }
  ]
}
