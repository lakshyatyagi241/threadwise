{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Edge-case catalogue file (one per API module)",
  "type": "object",
  "required": ["module", "tier", "cases"],
  "additionalProperties": false,
  "properties": {
    "module": { "type": "string", "description": "Folder name under apps/api/src/modules" },
    "tier": {
      "enum": ["P0", "P1", "P2"],
      "description": "How important the module is. P0 modules must have no untested P0 case."
    },
    "owner": { "type": "string" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "feature", "category", "scenario", "expected", "priority", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EC-[a-z0-9-]+-[0-9]{3}$",
            "description": "EC-<module>-<nnn>, unique across the catalogue"
          },
          "feature": { "type": "string" },
          "category": {
            "enum": ["input", "state", "permission", "time", "concurrency", "integration", "data"]
          },
          "scenario": { "type": "string" },
          "expected": { "type": "string" },
          "priority": { "enum": ["P0", "P1", "P2"] },
          "status": { "enum": ["covered", "gap"] },
          "source": {
            "type": "string",
            "description": "Where the case came from: a parity note, a contract limit, an error code"
          },
          "tests": {
            "type": "array",
            "description": "Required when status is covered. Each entry is a test file; `match` is a title substring that must appear in the file. Without `match` the file must contain the case id (in a title or a `covers:` comment).",
            "items": {
              "type": "object",
              "required": ["file"],
              "additionalProperties": false,
              "properties": { "file": { "type": "string" }, "match": { "type": "string" } }
            }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
