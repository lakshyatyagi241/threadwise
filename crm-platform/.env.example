# ---------------------------------------------------------------------------
# Copy to .env and adjust. The API validates this file with zod at bootstrap
# and REFUSES TO START on a missing or malformed value — no silent undefined.
# ---------------------------------------------------------------------------

# --- docker compose host ports --------------------------------------------
# Only the HOST side. Change these if another project on this machine already
# owns the default port; the URLs below must match whatever you pick.
POSTGRES_PORT=5432
POSTGRES_REPLICA_PORT=5433
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Set to true to run this process as a BullMQ worker (no HTTP listener).
# Same image, different command — see apps/api/src/worker.ts
WORKER_MODE=false

# --- Database -------------------------------------------------------------
# The APPLICATION connects as a non-superuser. This matters: a superuser
# bypasses Row-Level Security entirely, so connecting as the owner would leave
# every isolation policy in place and completely inert.
DATABASE_URL=postgres://crm_app_user:crm_app_dev@localhost:5432/crm

# Migrations and seeds run as the OWNER — they need CREATE EXTENSION, table
# ownership and cross-tenant writes. Falls back to DATABASE_URL if unset.
MIGRATION_DATABASE_URL=postgres://crm:crm@localhost:5432/crm
# Read replica. Partner panel + /public/v1 reads are routed here.
# Locally you may point it at the primary; production must not.
DATABASE_REPLICA_URL=postgres://crm_app_user:crm_app_dev@localhost:5432/crm
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (BullMQ, RBAC grant cache, socket.io adapter) ------------------
REDIS_URL=redis://localhost:6379

# --- Auth -----------------------------------------------------------------
# openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-in-every-real-environment
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-in-every-real-environment
JWT_REFRESH_TTL=30d

# Clerk verifies the credential client-side; this backend verifies the
# resulting session token server-side. dashboard.clerk.com -> API Keys.
CLERK_SECRET_KEY=sk_test_replace_me

# AES-256-GCM key for reversible secrets (channel access tokens, API-key HMAC
# secrets, gateway credentials). Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktZG8tbm90LXVzZSE=
# Key rotation: put the retired key(s) here (comma-separated), run `pnpm --filter @crm/api secrets:reencrypt`, then remove them.
# CREDENTIALS_ENCRYPTION_PREVIOUS_KEYS=

# --- Object storage (MinIO locally, S3 in production) ---------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_MEDIA=crm-media
S3_BUCKET_DOCUMENTS=crm-documents
S3_BUCKET_EXPORTS=crm-exports
S3_ACCESS_KEY_ID=crmminio
S3_SECRET_ACCESS_KEY=crmminio123
S3_FORCE_PATH_STYLE=true

# Chat media (inbox attachments). Used when no cloud bucket is enabled in the platform storage settings: files go to this folder,
# which must be OUTSIDE the repository (default: ~/.crm-platform/media) and is only ever read through the authenticated media route.
# MEDIA_LOCAL_DIR=
# Size limits per kind, in bytes (WhatsApp's own: 5 MB images, 16 MB audio and video, 100 MB documents), and how long a media link works.
# MEDIA_MAX_BYTES_IMAGE=5242880
# MEDIA_MAX_BYTES_MEDIA=16777216
# MEDIA_MAX_BYTES_DOCUMENT=104857600
# MEDIA_TOKEN_TTL_SECONDS=300

# --- Email (Mailpit locally) ----------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@localhost
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- Web app (links in mail, OAuth redirect allow-list) -------------------
WEB_APP_URL=http://localhost:3001
# Proxies whose X-Forwarded-For is believed: hop count, 'loopback', or addresses/CIDRs (never '*').
TRUST_PROXY=loopback
# Web app: how many proxies in front of it append to X-Forwarded-For. 0 (default) means the header is
# never believed and the API records the web server's address; set 1 behind one load balancer.
WEB_TRUSTED_PROXY_HOPS=0
APP_NAME=CRM Platform

# --- WhatsApp: Meta Cloud API --------------------------------------------
META_GRAPH_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=dev-app-secret

# --- Facebook Pages (WD-FB) -----------------------------------------------
# One Meta app serves WhatsApp and Facebook: leave these unset to reuse WHATSAPP_* and META_GRAPH_VERSION.
# META_APP_ID=
# FB_APP_ID=
# FB_APP_SECRET=
# FB_WEBHOOK_VERIFY_TOKEN=
# FB_CONFIG_ID=
# FB_GRAPH_VERSION=
# The Graph version the Messenger welcome greeting is retried on when the configured one has dropped it (empty disables the retry).
# FB_GREETING_GRAPH_VERSION=v19.0
# Dev-only simulated messaging channel (chat conversations). The API REFUSES TO BOOT if this is true with NODE_ENV=production.
CHANNEL_SIMULATOR_ENABLED=true

# --- Live conversation notifications (BL-096; docs/api/notifications.md) --------------------------------------
# Off switch for new-chat / new-message / assignment / mention bell rows. Default: on outside production, off in production until set.
# NOTIFY_CONVERSATIONS_ENABLED=true
# The most people one event notifies (an unassigned new chat in a big workspace).
# NOTIFY_MAX_RECIPIENTS=50
# A burst in one chat pings a person at most once in this many seconds (the row still collapses and the badge still moves).
# NOTIFY_THROTTLE_SECONDS=5
# How many aggregates the worker's outbox drain dispatches at once (events of one aggregate stay in order). 1 to 16.
# OUTBOX_DRAIN_CONCURRENCY=6
# Retention of the bell feed (decision D5): a daily worker job deletes read rows older than READ_DAYS (min 30) and unread rows older than
# UNREAD_DAYS (raised to READ_DAYS if lower), in batches. Off: keep everything.
# NOTIFY_RETENTION_ENABLED=true
# NOTIFY_RETENTION_READ_DAYS=90
# NOTIFY_RETENTION_UNREAD_DAYS=180
# Rows per delete statement (100 to 50000) and statements per kind of row per run (a first run over a huge backlog continues the next day).
# NOTIFY_RETENTION_BATCH_SIZE=5000
# NOTIFY_RETENTION_MAX_BATCHES=200
# "Waiting for a reply" nudge (BL-098): an unassigned, open chat whose latest customer message has gone unanswered this many minutes
# tells the people who may reply, once per waiting episode (a worker sweep every minute). Needs NOTIFY_CONVERSATIONS_ENABLED as well.
# NOTIFY_WAITING_ENABLED=true
# NOTIFY_WAITING_MINUTES=5
# Chats whose latest message is older than this many hours are skipped (switching the feature on never wakes an old backlog).
# NOTIFY_WAITING_LOOKBACK_HOURS=24
# The most chats one sweep handles.
# NOTIFY_WAITING_BATCH=100

# --- Browser notifications / Web Push (BL-097; docs/api/notifications.md) ---------------------------------------
# Leave all three EMPTY to keep the feature fully off and invisible (no card on Account, Notifications, nothing queued).
# Generate a pair once per deployment:  npx web-push generate-vapid-keys   (print it on your own terminal, never commit or paste it).
# Changing the pair later makes every saved browser device unusable; people just enable it again. The private key is a secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach if your server misbehaves: mailto:ops@your-domain.com (or an https URL).
VAPID_SUBJECT=
# How long a push service keeps a notification for a device that is offline, in seconds (60 to 86400). Default 14400 (4 hours).
# WEB_PUSH_TTL_SECONDS=14400

# --- Google Calendar for workspaces (WD-APPT-028; docs/runbooks/google-calendar-setup.md) ---------------
# The platform's Google OAuth client. Either set these or save the client on the console (Admin, Settings, Google Calendar); the console wins.
# Redirect URI to register at Google: <APP_URL>/v2/public/appointments/calendar/google/callback
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=
# Busy-time cache and back-off after a Google failure, in seconds; the per-call timeout in ms.
# GOOGLE_BUSY_CACHE_SECONDS=30
# GOOGLE_BUSY_BACKOFF_SECONDS=20
# GOOGLE_HTTP_TIMEOUT_MS=8000

# --- Geta console publishing (flow builder: Publish also pushes the bot live) -------------------------
# The credentials (base URL, authorization, geta-host, chatbot record) are NOT set here: each workspace enters its own under
# Settings -> Automation -> Geta publishing, and they are stored encrypted. These keys only tune the integration.
# fixture = in-memory stand-in, nothing leaves the machine (the default outside production); live = calls the Geta console.
GETA_PUBLISH_MODE=fixture
# Per request, in milliseconds.
GETA_PUBLISH_TIMEOUT_MS=15000
# Total tries per call; a network error, timeout, 429 or 5xx is retried with backoff, any other 4xx never.
GETA_PUBLISH_MAX_ATTEMPTS=3
GETA_PUBLISH_BACKOFF_MS=500
# Only for a local stub of the console: lets the base URL be http:// or a private address. Never true in production.
GETA_PUBLISH_ALLOW_PRIVATE_HOSTS=false

# --- Payments: Easebuzz ---------------------------------------------------
EASEBUZZ_ENV=test
EASEBUZZ_KEY=
EASEBUZZ_SALT=

# --- Public API (partner / external systems) ------------------------------
# HMAC request signatures are rejected outside this clock skew window.
PUBLIC_API_HMAC_WINDOW_SECONDS=300
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120

# --- Observability --------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- web app (apps/web) ---------------------------------------------------
# Server-side base URL the web app's proxy uses to reach the API. The browser never calls the API directly.
API_URL=http://localhost:3000
# Socket.IO endpoint the browser connects to (namespace /realtime). The page connects with a one-time ticket the web proxy fetches from
# POST /v2/realtime/ticket; the session token itself never reaches the browser. Set REALTIME_URL to override per deployment at runtime.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3000/realtime
