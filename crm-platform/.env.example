# ---------------------------------------------------------------------------
# Copy to .env and adjust. The API validates this file with zod at bootstrap
# and REFUSES TO START on a missing or malformed value — no silent undefined.
# ---------------------------------------------------------------------------

# --- docker compose host ports --------------------------------------------
# Only the HOST side. Change these if another project on this machine already
# owns the default port; the URLs below must match whatever you pick.
POSTGRES_PORT=5432
POSTGRES_REPLICA_PORT=5433
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Set to true to run this process as a BullMQ worker (no HTTP listener).
# Same image, different command — see apps/api/src/worker.ts
WORKER_MODE=false

# --- Database -------------------------------------------------------------
# The APPLICATION connects as a non-superuser. This matters: a superuser
# bypasses Row-Level Security entirely, so connecting as the owner would leave
# every isolation policy in place and completely inert.
DATABASE_URL=postgres://crm_app_user:crm_app_dev@localhost:5432/crm

# Migrations and seeds run as the OWNER — they need CREATE EXTENSION, table
# ownership and cross-tenant writes. Falls back to DATABASE_URL if unset.
MIGRATION_DATABASE_URL=postgres://crm:crm@localhost:5432/crm
# Read replica. Partner panel + /public/v1 reads are routed here.
# Locally you may point it at the primary; production must not.
DATABASE_REPLICA_URL=postgres://crm_app_user:crm_app_dev@localhost:5432/crm
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (BullMQ, RBAC grant cache, socket.io adapter) ------------------
REDIS_URL=redis://localhost:6379

# --- Auth -----------------------------------------------------------------
# openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-in-every-real-environment
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-in-every-real-environment
JWT_REFRESH_TTL=30d

# Clerk verifies the credential client-side; this backend verifies the
# resulting session token server-side. dashboard.clerk.com -> API Keys.
CLERK_SECRET_KEY=sk_test_replace_me

# AES-256-GCM key for reversible secrets (channel access tokens, API-key HMAC
# secrets, gateway credentials). Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktZG8tbm90LXVzZSE=

# --- Object storage (MinIO locally, S3 in production) ---------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_MEDIA=crm-media
S3_BUCKET_DOCUMENTS=crm-documents
S3_BUCKET_EXPORTS=crm-exports
S3_ACCESS_KEY_ID=crmminio
S3_SECRET_ACCESS_KEY=crmminio123
S3_FORCE_PATH_STYLE=true

# Chat media (inbox attachments). Used when no cloud bucket is enabled in the platform storage settings: files go to this folder,
# which must be OUTSIDE the repository (default: ~/.crm-platform/media) and is only ever read through the authenticated media route.
# MEDIA_LOCAL_DIR=
# Size limits per kind, in bytes (WhatsApp's own: 5 MB images, 16 MB audio and video, 100 MB documents), and how long a media link works.
# MEDIA_MAX_BYTES_IMAGE=5242880
# MEDIA_MAX_BYTES_MEDIA=16777216
# MEDIA_MAX_BYTES_DOCUMENT=104857600
# MEDIA_TOKEN_TTL_SECONDS=300

# --- Email (Mailpit locally) ----------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@localhost
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- Web app (links in mail, OAuth redirect allow-list) -------------------
WEB_APP_URL=http://localhost:3001
# Proxies whose X-Forwarded-For is believed: hop count, 'loopback', or addresses/CIDRs (never '*').
TRUST_PROXY=loopback
APP_NAME=CRM Platform

# --- WhatsApp: Meta Cloud API --------------------------------------------
META_GRAPH_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=dev-app-secret

# Dev-only simulated messaging channel (chat conversations). The API REFUSES TO BOOT if this is true with NODE_ENV=production.
CHANNEL_SIMULATOR_ENABLED=true

# --- Payments: Easebuzz ---------------------------------------------------
EASEBUZZ_ENV=test
EASEBUZZ_KEY=
EASEBUZZ_SALT=

# --- Public API (partner / external systems) ------------------------------
# HMAC request signatures are rejected outside this clock skew window.
PUBLIC_API_HMAC_WINDOW_SECONDS=300
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120

# --- Observability --------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- web app (apps/web) ---------------------------------------------------
# Server-side base URL the web app's proxy uses to reach the API. The browser never calls the API directly.
API_URL=http://localhost:3000
# Socket.IO endpoint the browser connects to (namespace /realtime). The page connects with a one-time ticket the web proxy fetches from
# POST /v2/realtime/ticket; the session token itself never reaches the browser. Set REALTIME_URL to override per deployment at runtime.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3000/realtime
