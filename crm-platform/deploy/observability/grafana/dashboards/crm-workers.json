    {
      "id": 5,
      "type": "stat",
      "title": "Job wait p95 (5 m)",
      "description": "Time between a job being added and starting. The first number to rise when workers fall behind.",
      "datasource": {
        "type": "prometheus",
        "uid": "crm-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "crm-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(crm_queue_job_wait_seconds_bucket{service=\"worker\",instance=~\"$instance\",queue=~\"$queue\"}[5m])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          },
          "mappings": [],
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
