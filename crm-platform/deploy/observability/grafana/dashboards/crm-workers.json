          "expr": "sum(rate(crm_queue_jobs_total{service=\"worker\",instance=~\"$instance\",queue=~\"$queue\",outcome=\"failed\"}[5m])) / sum(rate(crm_queue_jobs_total{service=\"worker\",instance=~\"$instance\",queue=~\"$queue\"}[5m]))",
