    {
      "id": 16,
      "type": "timeseries",
      "title": "Event loop delay",
      "description": "Worst API instance per reporting window. Lines: 50 ms (p99 warning target) and 250 ms. Alerts: EventLoopDelayP95Warning (20 ms, 5 m average), EventLoopDelayP99Warning (50 ms), EventLoopLongStall* (2 s and 10 s).",
      "datasource": {
        "type": "prometheus",
        "uid": "crm-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "crm-prometheus"
          },
          "expr": "max(crm_event_loop_delay_p50_seconds{service=\"api\",instance=~\"$instance\"})",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "crm-prometheus"
          },
          "expr": "max(crm_event_loop_delay_p95_seconds{service=\"api\",instance=~\"$instance\"})",
