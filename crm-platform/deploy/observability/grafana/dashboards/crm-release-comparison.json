{
  "uid": "crm-release-comparison",
  "title": "Threadwise release comparison: now against earlier",
  "description": "The same loop, latency, error, heap and queue queries now and one chosen window earlier, with process restarts marked. No release label exists on the series yet (EL-B18).",
  "tags": [
    "threadwise",
    "event-loop",
    "release"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "api,worker",
        "options": [
          {
            "text": "api",
            "value": "api",
            "selected": true
          },
          {
            "text": "worker",
            "value": "worker",
            "selected": false
          }
        ],
        "current": {
          "text": "api",
          "value": "api"
        },
        "multi": false,
        "includeAll": false
      },
      {
        "name": "compare",
        "label": "Compare with",
        "type": "custom",
        "query": "1h,6h,1d,3d,7d",
        "options": [
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": false
          },
          {
            "text": "1d",
            "value": "1d",
            "selected": true
          },
          {
            "text": "3d",
            "value": "3d",
            "selected": false
          },
          {
            "text": "7d",
            "value": "7d",
            "selected": false
          }
        ],
        "current": {
          "text": "1d",
          "value": "1d"
        },
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Process (re)start",
        "datasource": {
          "type": "prometheus",
          "uid": "crm-prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(crm_process_start_time_seconds{service=\"$service\"}[2m]) > 0",
        "titleFormat": "Process start",
        "textFormat": "{{service}} {{instance}}",
        "step": "1m",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Each graph draws the same query **now** and **`$compare` ago** (pick it at the top), so a release, a config change or a new traffic mix shows as the two lines parting. Vertical marks are process (re)starts of the chosen service, which is where a deploy lands.\n\n**Limit:** the series carry no release or version label, so \"before\" is a time offset, not a named release. Compare like with like (same weekday and hour: choose 1d or 7d), and read a difference next to the traffic panel, because load moves latency too. Adding a `release` label from the image tag is tracked as EL-B18."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Same moment, one window earlier",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Loop delay p99 now (1 h avg)",
      "datasource": {
        "type": "prometheus",
        "uid": "crm-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "crm-prometheus"
          },
          "expr": "avg_over_time(crm_event_loop_delay_p99_seconds{service=\"$service\"}[1h])",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Loop delay p99 $compare ago (1 h avg)",
      "datasource": {
        "type": "prometheus",
        "uid": "crm-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "crm-prometheus"
          },
          "expr": "avg_over_time(crm_event_loop_delay_p99_seconds{service=\"$service\"}[1h] offset $compare)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Change in loop delay p99",
      "description": "Positive means slower than the earlier window. Small absolute delays swing this a lot: read it with the two numbers beside it.",
      "datasource": {
        "type": "prometheus",
        "uid": "crm-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "crm-prometheus"
          },
          "expr": "avg_over_time(crm_event_loop_delay_p99_seconds{service=\"$service\"}[1h]) / avg_over_time(crm_event_loop_delay_p99_seconds{service=\"$service\"}[1h] offset $compare) - 1",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
