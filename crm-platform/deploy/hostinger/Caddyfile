# One public origin: the API paths go to the API, everything else to the web app.
# {$SITE_ADDRESS} is the domain (Caddy gets and renews the TLS certificate itself).
{$SITE_ADDRESS} {
	encode zstd gzip

	@api path /v2/* /socket.io/* /health /ready /docs /docs/*
	handle @api {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:3001
	}
}
