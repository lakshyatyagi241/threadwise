# Copy to .env (deploy.sh does this and fills every CHANGE_ME with a generated secret).
# Never commit the real .env.

DOMAIN=desk.wabo.ai
APP_NAME=Desk

POSTGRES_USER=crm
POSTGRES_DB=crm
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
WORKER_DB_PASSWORD=CHANGE_ME
# Sized for a shared host with 2 GB for Postgres (the postgres service's mem_limit): shared_buffers a quarter, cache size three quarters.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB

# Object storage: Cloudflare R2 (or any S3-compatible store). An API token with Object Read & Write on these buckets.
S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
S3_BUCKET_MEDIA=CHANGE_ME
S3_BUCKET_DOCUMENTS=CHANGE_ME
S3_BUCKET_EXPORTS=CHANGE_ME
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# Public address of the media bucket (custom domain or r2.dev) for links an outsider must fetch. Optional.
# S3_PUBLIC_ENDPOINT=

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
# base64 of 32 random bytes. Changing it later makes stored channel credentials unreadable.
CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME

# Required to be non-empty by the API schema. Put the real key here only if you use Clerk sign-in.
CLERK_SECRET_KEY=not-used

# Real outgoing mail is needed for sign-up verification and password reset. Fill these from your mail provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@wabo.ai

# Meta / WhatsApp Cloud API. Leave as is until you connect a number.
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_APP_SECRET=not-set-yet

# WhatsApp embedded signup. Fill these from your Meta developer app and your Interakt partner account, then:
#   docker compose --env-file .env up -d api worker
# Webhook URL to register at Meta/Interakt: https://<DOMAIN>/v2/public/webhooks/whatsapp  (verify token = WHATSAPP_VERIFY_TOKEN above)
WABA_DEFAULT_PROVIDER=interakt
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_CONFIG_ID=
# Login-for-Business configuration used only to create a catalog (its token carries catalog_management). Blank keeps the number's own token.
META_CATALOGUE_CONFIG_ID=
# true offers "connect my existing WhatsApp Business app number" (coexistence) in Embedded Signup.
WABA_COEXISTENCE=false
# Source IPs whose unsigned callback POSTs are accepted (a relay such as Geta that re-posts the body without Meta's signature). Empty trusts nobody.
WABA_TRUSTED_FORWARDER_IPS=
INTERAKT_PARTNER_AUTH_KEY=
INTERAKT_SOLUTION_ID=
META_SYSTEM_USER_ID=
META_SYSTEM_USER_TOKEN=
META_BUSINESS_ID=

# Google Calendar for workspaces' bookings (docs/runbooks/google-calendar-setup.md). Either fill these or save the client on the console's
# Admin, Settings, Google Calendar page. Redirect URI to register at Google: https://<DOMAIN>/v2/public/appointments/calendar/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Nightly database dump (docs/runbooks/backup-restore.md). Both optional.
# BACKUP_HOUR_UTC=2
# BACKUP_KEEP_DAYS=14

# Only while rotating the encryption key (docs/runbooks/key-rotation.md): the old key(s), comma-separated base64.
# CREDENTIALS_ENCRYPTION_PREVIOUS_KEYS=

# Off-host copies of the database dumps (docs/runbooks/backup-restore.md). Until all five are set the `offsite` service just says so and stops.
# Cloudflare R2: endpoint https://<account id>.r2.cloudflarestorage.com, an API token with Object Read & Write on this ONE bucket.
# OFFSITE_BACKUP_KEY seals every dump before upload (openssl rand -base64 32). Keep a copy OUTSIDE this server and apart from the
# bucket keys: without it the copies cannot be opened.
# OFFSITE_S3_ENDPOINT=
# OFFSITE_S3_BUCKET=
# OFFSITE_S3_ACCESS_KEY_ID=
# OFFSITE_S3_SECRET_ACCESS_KEY=
# OFFSITE_BACKUP_KEY=
# OFFSITE_S3_PREFIX=desk

# Error reporting (Sentry). The DSN is public by design and is already the default in docker-compose.yml, so nothing is needed here.
# Uncomment to point at a different project, or set it EMPTY to turn reporting off. The browser's copy of the DSN is fixed at image build
# time by the deploy workflow, so changing it here affects the API, the worker and the web server, not the browser bundle.
# SENTRY_DSN=

# Event-loop metrics, alerts and a caller-side probe (docs/performance/event-loop/event-loop-observability-runbook.md). Off until you run
#   ./observability-up.sh
# which generates the token below, asks for the alert destination and starts Prometheus, Alertmanager and the probe next to the app.
# OBS_METRICS_TOKEN=

# Waboo migration panel (admin console -> Migration). The pipeline needs Waboo's database, which only answers over the Geta VPN, so it runs
# on a runner agent on a machine on the VPN: set WABOO_MIGRATE_RUNNER=remote and a token of 32+ characters, and give the SAME token to the
# agent (tools/migration/pilot/staging/STAGING-RUNBOOK.md, "Running it from the admin panel"). Empty = the agent endpoints refuse everyone.
# WABOO_MIGRATE_RUNNER=remote
# WABOO_RUNNER_TOKEN=
# WABOO_RUNNER_PICKUP_MIN=10
# WABOO_RUNNER_SILENCE_MIN=5
# WABOO_MIGRATE_TIMEOUT_MIN=90
# Optional: Grafana host name for observability.compose.yml (default grafana.$DOMAIN). Needs a DNS A record to this host.
#GRAFANA_DOMAIN=
