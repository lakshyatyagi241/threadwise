# Public routing for the desk host, written by ci-entry.sh on every release (route_to). The API paths go to the live API slot and
# everything else to the live web slot. Traefik watches its dynamic directory, so rewriting this file moves traffic with no restart.
# ci-entry.sh fills in __DOMAIN__ and __SLOT__ (blue or green).
# The public webhook receiver has its own container (desk-api-hooks, not in a slot). Its service is a failover: while that container
# answers /health it takes the traffic, and while it does not (a restart, a failed start) the live slot's API takes it, so a webhook is
# never refused for want of it. /health is the liveness probe, not /ready: a database blip must not move the webhooks onto the slot.
http:
  routers:
    desk-api:
      rule: Host(`__DOMAIN__`) && (PathPrefix(`/v2`) || PathPrefix(`/socket.io`) || PathPrefix(`/health`) || PathPrefix(`/ready`) || PathPrefix(`/api/v1`) || PathPrefix(`/public/v1`) || Path(`/docs/api.json`))
      entryPoints: [websecure]
      service: desk-api
      priority: 100
      tls:
        certResolver: letsencrypt
    desk-hooks:
      rule: Host(`__DOMAIN__`) && PathPrefix(`/v2/public/webhooks`)
      entryPoints: [websecure]
      service: desk-hooks
      priority: 200
      tls:
        certResolver: letsencrypt
    desk-web:
      rule: Host(`__DOMAIN__`)
      entryPoints: [websecure]
      service: desk-web
      priority: 10
      tls:
        certResolver: letsencrypt
    desk-http:
      rule: Host(`__DOMAIN__`)
      entryPoints: [web]
      service: desk-web
      middlewares: [desk-https]
  middlewares:
    desk-https:
      redirectScheme:
        scheme: https
  services:
    desk-api:
      loadBalancer:
        servers:
          - url: http://desk-api-__SLOT__:3000
    desk-web:
      loadBalancer:
        servers:
          - url: http://desk-web-__SLOT__:3001
    desk-hooks:
      failover:
        service: desk-hooks-main
        fallback: desk-api
    desk-hooks-main:
      loadBalancer:
        healthCheck:
          path: /health
          interval: 10s
          timeout: 3s
        servers:
          - url: http://desk-api-hooks:3000
