{
  "name": "@crm/web",
  "version": "0.1.0",
  "private": true,
  "description": "Staff CRM web app (Next.js App Router)",
  "scripts": {
    "dev": "node scripts/gen-registry.mjs && next dev -p 3001",
    "build": "node scripts/gen-registry.mjs && next build",
    "start": "next start -p 3001",
    "typecheck": "node scripts/gen-registry.mjs && next typegen && tsc --noEmit",
    "lint": "node scripts/gen-registry.mjs && eslint src",
    "test": "node scripts/gen-registry.mjs && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@crm/contracts": "workspace:*",
    "@crm/tax": "workspace:*",
    "@crm/ui": "workspace:*",
    "@page-agent/core": "1.12.4",
    "@page-agent/page-controller": "1.12.4",
    "@sentry/nextjs": "^11.5.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "^5.104.1",
    "flag-icons": "^7.5.0",
    "intl-tel-input": "^28.1.0",
    "libphonenumber-js": "^1.13.15",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "vitest": "^2.1.9"
  }
}
