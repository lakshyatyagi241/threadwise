{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "description": "CRM platform API \u2014 HTTP, WebSocket and BullMQ worker in one deployable",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "nest start --watch -b swc",
    "dev:worker": "cross-env WORKER_MODE=true nest start --watch -b swc --entryFile worker",
    "build": "nest build -b swc",
    "start": "node dist/src/main.js",
    "start:worker": "WORKER_MODE=true node dist/src/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --dir test/unit",
    "test:watch": "vitest --dir test/unit",
    "test:integration": "vitest run --dir test/integration --testTimeout=120000",
    "test:e2e": "vitest run --dir test/e2e --testTimeout=120000",
    "openapi": "tsx src/tools/emit-openapi.ts",
    "waba:smoke": "tsx src/tools/waba-smoke.ts",
    "secrets:reencrypt": "tsx src/modules/auth/maintenance/reencrypt-secrets.cli.ts",
    "clean": "rm -rf dist coverage",
    "arch": "depcruise --config .dependency-cruiser.cjs src",
    "seed:auth": "tsx src/modules/auth/cli/seed-auth.ts",
    "seed:store-demo": "swc src -d dist-cli --strip-leading-paths --ignore \"**/*.spec.ts\" -q && node dist-cli/modules/storefront-builder/cli/seed-store-demo.js",
    "backfill:store-orders": "swc src -d dist-cli --strip-leading-paths --ignore \"**/*.spec.ts\" -q && node dist-cli/modules/store-orders-sales/cli/backfill-store-orders.js",
    "operator:create": "tsx src/modules/auth/cli/create-operator.ts",
    "auto-reply:translate-existing": "node dist/src/modules/localization-translation/cli/translate-existing.js",
    "seed:appointments": "node dist/src/modules/marketplace/cli/seed-appointments.js"
  },
  "dependencies": {
    "@clerk/backend": "^3.22.0",
    "@crm/contracts": "workspace:*",
    "@crm/db": "workspace:*",
    "@crm/tax": "workspace:*",
    "@nestjs/bullmq": "^11.0.1",
    "@nestjs/common": "^11.0.5",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.5",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.5",
    "@nestjs/platform-socket.io": "^11.0.5",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/websockets": "^11.0.5",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^8.51.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "baileys": "6.7.24",
    "bullmq": "^6.3.11",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "https-proxy-agent": "7.0.6",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.18.0",
    "socket.io": "^4.8.4",
    "socks-proxy-agent": "8.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/testing": "^11.0.5",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^16.9.0",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.3.0",
    "testcontainers": "^10.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
