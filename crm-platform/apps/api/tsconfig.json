{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    /* rootDir must be `src` (not `.`) or the build emits dist/src/main.js and
       every start command, Dockerfile CMD and deploy script has to know it. */
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@/*": ["src/*"],
      /* Type-only: moduleResolution "node" ignores the package's exports map, so the v2 entry point is pointed at its declarations.
         Runtime resolution (swc, vitest, node) still goes through the exports map, which this does not touch. */
      "@copilotkit/runtime/v2": ["node_modules/@copilotkit/runtime/dist/v2/index.d.cts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
