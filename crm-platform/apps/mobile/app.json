{
  "expo": {
    "name": "Reference",
    "slug": "threadwise",
    "scheme": "threadwise",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#128C7E"
    },
    "ios": {
      "bundleIdentifier": "ai.geta.threadwise",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos to send in chats.",
        "NSPhotoLibraryUsageDescription": "Choose photos and videos to send in chats.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.geta.threadwise",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#128C7E"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#128C7E"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take photos to send in chats.",
          "photosPermission": "Choose photos and videos to send in chats."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "278caaa7-9b60-46f1-98cd-ddaf0bc92ab6"
      }
    },
    "owner": "akshay-narkhede-01"
  }
}