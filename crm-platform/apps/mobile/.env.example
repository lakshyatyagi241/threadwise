# Copy to .env for local development. Expo loads it automatically.
#
# EXPO_PUBLIC_* values are compiled into the app bundle and readable by anyone who installs it.
# NEVER put a secret (a key, a token, a password) in an EXPO_PUBLIC_* variable. `pnpm env:check` fails on the usual suspects.
# Staging and production values are EAS environment variables (eas env:set), not files in git.

# Where the CRM API runs, as the PHONE reaches it:
#   iOS simulator                 http://localhost:3000
#   Android emulator              http://10.0.2.2:3000
#   physical device (same wifi)   http://<your computer's LAN ip>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional. Error reporting stays off when empty.
EXPO_PUBLIC_SENTRY_DSN=

# Optional. Where the web app lives. The Terms and Privacy links on the sign-in and sign-up screens are stored by the platform
# as paths ("/legal/terms") unless an administrator sets full addresses; without this they show as plain text, not links.
#   local web app, from a phone   http://<your computer's LAN ip>:3001
EXPO_PUBLIC_WEB_URL=

# Build-time only (not bundled). Needed once EAS is set up: `eas init` prints the project id.
# EAS_PROJECT_ID=
# APP_BUNDLE_ID=ai.geta.crm
# APP_NAME=CRM
# SENTRY_ORG=
# SENTRY_PROJECT=
