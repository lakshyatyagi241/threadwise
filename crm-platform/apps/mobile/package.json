{
  "name": "@crm/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Staff CRM mobile app (Expo / React Native, iOS and Android)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "test:coverage": "jest --ci --coverage",
    "arch": "depcruise --config .dependency-cruiser.cjs src",
    "i18n:check": "node scripts/check-i18n.mjs",
    "env:check": "node scripts/check-public-env.mjs",
    "expo-doctor": "npx --yes expo-doctor@latest",
    "deps:check": "expo install --check",
    "bundle:check": "expo export --platform android --platform ios --output-dir .expo-export --clear",
    "e2e": "maestro test .maestro"
  },
  "dependencies": {
    "@crm/contracts": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.19",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "i18next": "^26.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "dependency-cruiser": "^18.5.0",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  }
}
