{
  "name": "@crm/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schema, hand-written SQL migrations, migration runner, seeds",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "migrate": "tsx src/cli/migrate.ts up",
    "status": "tsx src/cli/migrate.ts status",
    "new": "tsx src/cli/migrate.ts new",
    "verify-schema": "tsx src/cli/verify-schema.ts",
    "seed": "tsx src/cli/seed.ts",
    "reset": "tsx src/cli/migrate.ts reset && tsx src/cli/seed.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.11.10",
    "dotenv": "^18.0.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
