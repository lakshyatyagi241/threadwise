{
  "name": "@crm/tax",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript money, tax and invoice-totals engine with country tax profiles (no Node-only or browser-only APIs)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
