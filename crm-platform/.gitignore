# TypeScript incremental build caches
*.tsbuildinfo

# Redis snapshot written when redis-server runs from the repo root
dump.rdb

# Logs of the local dev stack started by tools/dev-refresh.sh
.dev-run/

# Database dumps written by the backup service on the host (deploy/hostinger/docker-compose.yml)
deploy/hostinger/backups/

# generated by pnpm audit:auth (the CI job uploads it as an artifact)
