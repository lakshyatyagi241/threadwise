{
  "name": "crm-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant metadata-driven CRM platform \u2014 kernel + CRM, Inbox, Broadcast, Billing, Exams",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @crm/api dev",
    "dev:worker": "pnpm --filter @crm/api dev:worker",
    "dev:web": "pnpm --filter @crm/web dev",
    "dev:refresh": "bash tools/dev-refresh.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @crm/api test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch:check": "pnpm --filter @crm/api arch",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:nuke": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "db:migrate": "pnpm --filter @crm/db migrate",
    "db:status": "pnpm --filter @crm/db status",
    "db:new": "pnpm --filter @crm/db new",
    "db:verify-schema": "pnpm --filter @crm/db verify-schema",
    "db:seed": "pnpm --filter @crm/db seed",
    "db:reset": "pnpm --filter @crm/db reset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.9.9",
    "turbo": "^2.11.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.4.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-gpj5-g38j-94v9"
      ]
    }
  }
}
