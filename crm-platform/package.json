{
  "name": "crm-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant metadata-driven CRM platform \u2014 kernel + CRM, Inbox, Broadcast, Billing, Exams",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @crm/api dev",
    "dev:worker": "pnpm --filter @crm/api dev:worker",
    "dev:web": "pnpm --filter @crm/web dev",
    "dev:refresh": "bash tools/dev-refresh.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @crm/api test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch:check": "pnpm --filter @crm/api arch",
    "audit:auth": "node tools/auth-audit/run.mjs",
    "audit:authz": "node tools/authz-audit/run.mjs",
    "audit:tenancy": "node tools/tenancy-audit/run.mjs",
    "audit:sast": "node tools/sast-report/run.mjs",
    "audit:event-loop": "node tools/event-loop-audit/scan.mjs --check",
    "qa": "node tools/qa-suite/run.mjs",
    "qa:reports": "node tools/qa-suite/report/generate.mjs",
    "qa:error-states": "node tools/quality/state-catalogue.mjs error && node --test tools/quality/state-catalogue.test.mjs",
    "qa:empty-states": "node tools/quality/state-catalogue.mjs empty && node --test tools/quality/state-catalogue.test.mjs",
    "qa:script-testing": "bash script-testing/run-all.sh",
    "qa:script-testing:list": "bash script-testing/run-all.sh --list",
    "qa:script-testing:quick": "bash script-testing/run-all.sh --quick",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:nuke": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "db:migrate": "pnpm --filter @crm/db migrate",
    "db:status": "pnpm --filter @crm/db status",
    "db:new": "pnpm --filter @crm/db new",
    "db:verify-schema": "pnpm --filter @crm/db verify-schema",
    "db:seed": "pnpm --filter @crm/db seed",
    "db:reset": "pnpm --filter @crm/db reset",
    "prepare": "husky",
    "audit:resource-limits": "node tools/resource-limits/check.mjs --check && node --test tools/resource-limits/lib.test.mjs",
    "test:redis-pressure": "bash tools/resource-limits/redis-pressure.sh",
    "audit:queue-capacity": "node tools/queue-capacity/inventory.mjs --check && node --test tools/queue-capacity/model.test.mjs",
    "bench:queues": "node tools/queue-capacity/bench.mjs",
    "fuzz": "node tools/quality/fuzz.mjs",
    "fuzz:ci": "node tools/quality/fuzz.mjs --profile ci --no-http"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.18.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.4.0",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "js-yaml@>=5.0.0 <=5.4.0": ">=5.4.1",
      "@grpc/grpc-js": ">=1.14.5"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
