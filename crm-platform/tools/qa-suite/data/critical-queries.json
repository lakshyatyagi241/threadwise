{
  "_comment": "Critical query patterns. Each needs an index serving its equality filters (any order) then its ORDER BY. Add the query when you add a hot path; the idx check (#40) and the plan check (#42) both read this file.",
  "queries": [
    {
      "name": "contacts list, newest first",
      "table": "contacts",
      "equals": ["org_id"],
      "orderBy": ["created_at DESC", "id DESC"],
      "why": "contacts page",
      "where": "is_archived = false"
    },
    {
      "name": "contacts by owner",
      "table": "contacts",
      "equals": ["org_id", "owner_id"],
