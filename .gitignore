# local database, WhatsApp session state, uploads, logs, compiled assets.
/reference/app/vendor/
/reference/app/public/build/
/reference/app/public/uploads/
/reference/app/public/storage
/reference/app/database/database.sqlite
/reference/app/node/baileys_auth/
/reference/app/storage/logs/*
/reference/app/storage/framework/cache/*
/reference/app/storage/framework/sessions/*
/reference/app/storage/framework/views/*
/reference/app/storage/app/*

# Local environment, secrets, build output
.env
.env.*
!.env.example
node_modules/
dist/
.turbo/
*.log
.DS_Store

