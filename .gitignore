# WaDesk reference (licensed CodeCanyon product, tracked on purpose, see wadesk-reference/README.md).
# Only the product source is tracked. Anything created by installing or running it stays out: secrets, dependencies,
# local database, WhatsApp session state, uploads, logs, compiled assets.
/wadesk-reference/WaDesk/vendor/
/wadesk-reference/WaDesk/public/build/
/wadesk-reference/WaDesk/public/uploads/
/wadesk-reference/WaDesk/public/storage
/wadesk-reference/WaDesk/database/database.sqlite
/wadesk-reference/WaDesk/node/baileys_auth/
/wadesk-reference/WaDesk/storage/logs/*
/wadesk-reference/WaDesk/storage/framework/cache/*
/wadesk-reference/WaDesk/storage/framework/sessions/*
/wadesk-reference/WaDesk/storage/framework/views/*
/wadesk-reference/WaDesk/storage/app/*

# Local environment, secrets, build output
.env
.env.*
!.env.example
node_modules/
dist/
.turbo/
*.log
.DS_Store

# Generated by the audit tools; regenerate with the wadesk-inventory-refresh skill
/_work/reports/
__pycache__/
*.pyc

# Generated workbook
/_work/out/
